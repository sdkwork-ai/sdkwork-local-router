# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user with a `_demo` suffix
# and a dedicated Redis logical DB index so no cache/idempotency key ever collides with another
# shared-redis environment. See the isolation section below.
SDKWORK_LOCAL_ROUTER_DEPLOYMENT_PROFILE=standalone
SDKWORK_LOCAL_ROUTER_ENVIRONMENT=demo
SDKWORK_LOCAL_ROUTER_PROFILE_ID=standalone.demo
SDKWORK_ENV=demo

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_LOCAL_ROUTER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Dedicated demo ingress bind/port (kept apart from development 8080 for a distinct test origin).
SDKWORK_LOCAL_ROUTER_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:8073
SDKWORK_LOCAL_ROUTER_APPLICATION_PUBLIC_HTTP_URL=http://local-router-demo.sdkwork.com:8073
VITE_SDKWORK_LOCAL_ROUTER_APPLICATION_PUBLIC_HTTP_URL=http://local-router-demo.sdkwork.com:8073

SDKWORK_LR_BIND=0.0.0.0
SDKWORK_LR_PORT=8073

# Isolated demo backing stores (hard isolation on shared infrastructure):
# - PostgreSQL: dedicated database/schema/user `sdkwork_local_router_demo` on the shared instance.
# - Redis: dedicated logical DB index (e.g. .../9) and an `sdkwork-local-router-demo` key prefix so
#   rate-limit and idempotency keys never collide with dev/test/staging/prod.
# Provide the concrete database/redis URLs through deployment process secrets.
