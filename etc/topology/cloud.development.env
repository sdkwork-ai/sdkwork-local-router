# cloud.development
SDKWORK_LOCAL_ROUTER_DEPLOYMENT_PROFILE=cloud
SDKWORK_LOCAL_ROUTER_ENVIRONMENT=development
SDKWORK_LOCAL_ROUTER_PROFILE_ID=cloud.development

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_LOCAL_ROUTER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_LOCAL_ROUTER_APPLICATION_PUBLIC_HTTP_URL=https://api-dev.sdkwork.com/apps/sdkwork-local-router
VITE_SDKWORK_LOCAL_ROUTER_APPLICATION_PUBLIC_HTTP_URL=https://api-dev.sdkwork.com/apps/sdkwork-local-router
SDKWORK_LOCAL_ROUTER_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com
VITE_SDKWORK_LOCAL_ROUTER_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com


# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
SDKWORK_CORS_ALLOWED_ORIGINS=https://local-router-dev.sdkwork.com,http://local-router-dev.sdkwork.com,https://local-router-dev.birdcoder.com,http://local-router-dev.birdcoder.com,https://local-router-dev.dtupay.com,http://local-router-dev.dtupay.com,https://local-router-dev.noaper.com,http://local-router-dev.noaper.com,https://local-router-dev.sdkwork.cn,http://local-router-dev.sdkwork.cn,https://local-router-dev.birdcoder.cn,http://local-router-dev.birdcoder.cn,https://local-router-dev.dtupay.cn,http://local-router-dev.dtupay.cn,https://local-router-dev.noaper.cn,http://local-router-dev.noaper.cn,https://local-router-dev.skubc.com,http://local-router-dev.skubc.com,https://local-router-dev.skubc.cn,http://local-router-dev.skubc.cn,https://local-router-dev.zowalk.com,http://local-router-dev.zowalk.com,https://local-router-dev.zowalk.cn,http://local-router-dev.zowalk.cn,https://local-router-dev.offer86.com,http://local-router-dev.offer86.com,https://local-router-dev.offer86.cn,http://local-router-dev.offer86.cn,https://local-router-dev.86offer.com,http://local-router-dev.86offer.com,https://local-router-dev.86offer.cn,http://local-router-dev.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
