# cloud.demo — cloud independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user with a `_demo` suffix
# and a dedicated Redis logical DB index so no cache/idempotency key ever collides with another
# shared-redis environment.
SDKWORK_LOCAL_ROUTER_DEPLOYMENT_PROFILE=cloud
SDKWORK_LOCAL_ROUTER_ENVIRONMENT=demo
SDKWORK_LOCAL_ROUTER_PROFILE_ID=cloud.demo
SDKWORK_ENV=demo

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_LOCAL_ROUTER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Dedicated demo public hosts (see topology.spec.json cloudPublicHosts environments["demo"]).
SDKWORK_LOCAL_ROUTER_APPLICATION_PUBLIC_HTTP_URL=https://local-router-demo.sdkwork.com
VITE_SDKWORK_LOCAL_ROUTER_APPLICATION_PUBLIC_HTTP_URL=https://local-router-demo.sdkwork.com
SDKWORK_LOCAL_ROUTER_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
VITE_SDKWORK_LOCAL_ROUTER_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com

# Isolated backing stores: dedicated Postgres schema/user `sdkwork_local_router_demo` and a
# dedicated Redis logical DB index (`.../9`) / `sdkwork-local-router-demo` prefix so keys never
# collide with dev/test/staging/prod. Provide concrete URLs through deployment secrets.
SDKWORK_CORS_ALLOWED_ORIGINS=https://local-router-demo.sdkwork.com,http://local-router-demo.sdkwork.com,https://local-router-demo.birdcoder.com,http://local-router-demo.birdcoder.com,https://local-router-demo.dtupay.com,http://local-router-demo.dtupay.com,https://local-router-demo.noaper.com,http://local-router-demo.noaper.com,https://local-router-demo.sdkwork.cn,http://local-router-demo.sdkwork.cn,https://local-router-demo.birdcoder.cn,http://local-router-demo.birdcoder.cn,https://local-router-demo.dtupay.cn,http://local-router-demo.dtupay.cn,https://local-router-demo.noaper.cn,http://local-router-demo.noaper.cn,https://local-router-demo.skubc.com,http://local-router-demo.skubc.com,https://local-router-demo.skubc.cn,http://local-router-demo.skubc.cn,https://local-router-demo.zowalk.com,http://local-router-demo.zowalk.com,https://local-router-demo.zowalk.cn,http://local-router-demo.zowalk.cn,https://local-router-demo.offer86.com,http://local-router-demo.offer86.com,https://local-router-demo.offer86.cn,http://local-router-demo.offer86.cn,https://local-router-demo.86offer.com,http://local-router-demo.86offer.com,https://local-router-demo.86offer.cn,http://local-router-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
