{
  "schemaVersion": 1,
  "kind": "sdkwork.component-deployment",
  "application": "sdkwork-local-router-sdkwork-modelkit-pc",
  "parentDeploymentConfig": "../../../etc/sdkwork.deployment.config.json",
  "parentTopologySpec": "../../../specs/topology.spec.json",
  "profiles": {
    "cloud.development": {
      "source": "browser/runtime-env.cloud.development.json"
    },
    "cloud.test": {
      "source": "browser/runtime-env.cloud.test.json"
    },
    "cloud.staging": {
      "source": "browser/runtime-env.cloud.staging.json"
    },
    "cloud.production": {
      "source": "browser/runtime-env.cloud.production.json"
    },
    "standalone.development": {
      "source": "browser/runtime-env.standalone.development.json"
    },
    "standalone.test": {
      "source": "browser/runtime-env.standalone.test.json"
    },
    "standalone.staging": {
      "source": "browser/runtime-env.standalone.staging.json"
    },
    "standalone.production": {
      "source": "browser/runtime-env.standalone.production.json"
    }
  },
  "materialization": {
    "authority": "../../../etc/sdkwork.deployment.config.json",
    "command": "node scripts/materialize-runtime-env.mjs",
    "format": "json",
    "output": "../public/runtime-env.json",
    "checkMode": "--check"
  },
  "runtimeTarget": "browser"
}
